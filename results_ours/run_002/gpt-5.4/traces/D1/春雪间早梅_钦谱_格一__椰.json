          "call": {
            "name": "validate_meter",
            "arguments": {
              "poem_text": "海角轻阴过雨，正万叶、摇动新凉。向晚潮平沙软，翠羽低张。曾向炎州深处，见琼珠、初缀青房。乍剖时、玉浆微泻，齿颊生香。遥想月明岛外，映短笠、归棹横塘。露重无人庭院，影落回廊。莫道春心只在，奈此中、风味难忘。待醉里、闲题素扇，也说南乡。",
              "rule_name": "春雪间早梅",
              "genre": "Ci",

          "call": {
            "name": "validate_meter",
            "arguments": {
              "poem_text": "雨细侵帘，烟冷满城，春事都迟。看小径、苔痕渐润，短檐不断，轻滴疏枝。燕子未来，海棠先瘦，谁共凭栏有所思。偏又是、晚风吹暮，暗添寒意，独立多时。\n\n梦里江南，篷背听波，灯外迷离。记柳岸、青蓑借酒，石桥系缆，柔橹惊漪。旧约难寻，新愁易积，写入吴笺总不宜。待霁后、碧空如洗，与君同看，一抹虹飞。",
              "rule_name": "远朝归",
              "genre": "Ci",
              "include_punctuation": true,
              "rhyme_book_name": "Cilinzhengyun"

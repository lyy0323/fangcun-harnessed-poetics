          "call": {
            "name": "validate_meter",
            "arguments": {
              "poem_text": "锦帐垂烟，牙床浸月，夜深人静时候。篆香细袅银屏，绣被微温纤手。灯花欲尽，照不得、旧痕消瘦。最难禁、梦短衾寒，听彻漏声偏骤。\n念几度、闲凭枕后。记那日、轻偎鬓右。如今翠幌空垂，只有晓寒依旧。鸳鸯枕冷，任辗转、一庭霜厚。待明朝、日上疏棂，独看镜中红袖。",
              "rule_name": "东风第一枝",

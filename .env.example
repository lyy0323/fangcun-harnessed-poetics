# FANGCUN Poetry Toolchain
# Copy to .env and fill in values.
# If using fangcun-cli binary: start it with `./dist/fangcun-cli serve --port 8901`
# and leave the defaults below.

# FANGCUN API proxy (default: local fangcun-cli proxy)
FANGCUN_WRITE_URL=http://localhost:8901
FANGCUN_CHECKER_URL=http://localhost:8901
FANGCUN_SHI_URL=http://localhost:8901

# LLM API key (for generation models)
OPENAI_COMPATIBLE_API_KEY=YOUR_API_KEY
